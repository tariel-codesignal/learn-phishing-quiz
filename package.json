{
  "name": "learn_phishing",
  "version": "0.0.2",
  "description": "CodeSignal phishing-awareness quiz on the Bespoke Simulation template",
  "main": "server.js",
  "scripts": {
    "start": "npm run start:prod",
    "start:prod": "IS_PRODUCTION=true node server.js",
    "start:dev": "concurrently \"npm run dev:vite\" \"npm run dev:api\"",
    "dev:vite": "vite",
